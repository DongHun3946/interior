# Copy this file to .env.production on the server and replace every CHANGE_ME value.
DOMAIN=jeil-interior.win

POSTGRES_DB=interior
POSTGRES_USER=interior
# Minimum 16 characters.
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
POSTGRES_VOLUME_NAME=interior_prod_postgres_data

# Minimum 32 characters. Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
ADMIN_LOGIN_ID=admin
# 12-72 UTF-8 bytes.
ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
# Leave empty to disable the management overview, or use at least 12 UTF-8 bytes.
MANAGEMENT_OVERVIEW_PASSWORD=

LOG_LEVEL=INFO
REQUEST_LOG_ENABLED=true
LOG_HEALTH_CHECKS=false

# Keep uploads on the Lightsail disk. Set these R2 values only when switching to R2.
STORAGE_BACKEND=local
STORAGE_PREFIX=interior-v1
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
VITE_ENABLE_SIMULATION=false
